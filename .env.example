# Copy to .env and fill in. Read by the services (python-dotenv) and by docker compose (--env-file).
MONGO_PASSWORD=
NEO4J_PASSWORD=
MINIO_ROOT_PASSWORD=
QDRANT_API_KEY=
# IP of the main Qdrant node (cluster mode).
QDRANT_P2P_HOST=
# Optional: without it the services use local models through Ollama.
OPENAI_API_KEY=
