CREATE VECTOR INDEX node_embedding_index
FOR (n:Node)
ON (n.embedding)
OPTIONS {
  indexConfig: {
    `vector.dimensions`: 1024,
    `vector.similarity_function`: 'cosine'
  }
}

CREATE FULLTEXT INDEX node_fulltext_index
FOR (n:Node)
ON EACH [n.name, n.type, n.text]



CREATE VECTOR INDEX rel_embedding_index IF NOT EXISTS
FOR ()-[r:RELATED]-() ON (r.embedding)
OPTIONS {indexConfig: {
 `vector.dimensions`: 1024,
 `vector.similarity_function`: 'cosine'
}};

CREATE FULLTEXT INDEX rel_fulltext_index IF NOT EXISTS
FOR ()-[r:RELATED]-() ON EACH [r.type];